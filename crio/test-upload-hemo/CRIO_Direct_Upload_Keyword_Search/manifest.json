{
  "manifest_version": 3,
  "name": "CRIO Direct Upload",
  "version": "1.0.0",
  "description": "Optional one-click Files upload with Other / Other and Hemodialysis Records.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.clinicalresearch.io/*"
  ],
  "action": {
    "default_title": "CRIO Direct Upload",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.clinicalresearch.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "https://app.clinicalresearch.io/*"
      ]
    }
  ]
}
