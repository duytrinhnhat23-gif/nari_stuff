{
  "manifest_version": 3,
  "name": "R1",
  "version": "1.1.0",
  "description": "R1 clinical data-entry helper with separate Visit Data, ConMed, and Medical History pages.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "R1",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "visit-data.js",
        "medical-history.js",
        "conmed.js",
        "router.js"
      ],
      "run_at": "document_idle"
    }
  ]
}